<Project Sdk="Microsoft.NET.Sdk.Web">
	<!-- Nidavellir: the guild + encrypted-backup API (Decision 24). Runs on the nidavellir LXC
	     behind Tailscale Funnel; deployed with deploy-server.sh, not by the Android CI. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Forge.Server</RootNamespace>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Forge.Core\Forge.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
	</ItemGroup>
</Project>
