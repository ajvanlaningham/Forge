<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Forge.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Forge"
    xmlns:views="clr-namespace:Forge.Views;assembly=Forge"
    xmlns:res="clr-namespace:Forge.Resources.Strings"
    Shell.FlyoutBehavior="Disabled"
    Title="Forge">

    <!-- Five tabs (Decisions 20, 24). Settings is a cog in each tab's top bar. -->
    <TabBar>
        <ShellContent Title="Today" ContentTemplate="{DataTemplate views:TodayPage}"
                      Route="today" Icon="{StaticResource IconToday}" />
        <ShellContent Title="Quest" ContentTemplate="{DataTemplate views:QuestPage}"
                      Route="quest" Icon="{StaticResource IconQuests}" />
        <ShellContent Title="Hero" ContentTemplate="{DataTemplate views:HeroPage}"
                      Route="hero" Icon="{StaticResource IconHero}" />
        <ShellContent Title="Chronicle" ContentTemplate="{DataTemplate views:ChroniclePage}"
                      Route="chronicle" Icon="{StaticResource IconChronicle}" />
        <ShellContent Title="Guild" ContentTemplate="{DataTemplate views:GuildPage}"
                      Route="guild" Icon="{StaticResource IconGuild}" />
    </TabBar>
</Shell>
