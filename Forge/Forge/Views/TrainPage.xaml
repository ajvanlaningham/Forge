<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Forge.ViewModels"
             x:Class="Forge.Views.TrainPage"
             x:DataType="vm:TrainViewModel"
             Title="Train">
    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="14">

            <!-- Session -->
            <Button Text="{Binding ResumeText}" Command="{Binding ResumeCommand}" IsVisible="{Binding HasInProgress}"
                    HeightRequest="64" FontFamily="PixelUI" FontSize="24"
                    BackgroundColor="{StaticResource Accent}" TextColor="{StaticResource Bg}" />
            <Button Text="{Binding StartText}" Command="{Binding StartProgramCommand}" IsVisible="{Binding CanStartProgram}"
                    HeightRequest="64" FontFamily="PixelUI" FontSize="24"
                    BackgroundColor="{StaticResource Accent}" TextColor="{StaticResource Bg}" />
            <Button Text="Start an open session" Command="{Binding StartEmptyCommand}" IsVisible="{Binding NoInProgress}" />

            <!-- Active program -->
            <Border Stroke="{StaticResource Accent}" StrokeThickness="2"
                    BackgroundColor="{StaticResource Surface}"
                    StrokeShape="RoundRectangle 10" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="PROGRAM" FontFamily="PixelUI" FontSize="16" TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding ProgramName}" FontFamily="PixelUI" FontSize="28"
                           TextColor="{StaticResource Accent}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding ProgramDescription}" FontSize="14" TextColor="{StaticResource OnBg}" />
                    <Label Text="Placeholder content — the real program comes later."
                           IsVisible="{Binding IsPlaceholder}" FontSize="12" TextColor="{StaticResource Muted}"
                           FontAttributes="Italic" />
                    <Label Text="{Binding BlockText}" FontSize="12" TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding NextDayText}" FontFamily="PixelUI" FontSize="22"
                           TextColor="{StaticResource OnBg}" Margin="0,6,0,0" />
                    <Button Text="Change program" Command="{Binding ChangeProgramCommand}" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Days -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Days}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProgramDayItem">
                        <Border Stroke="{StaticResource Muted}" StrokeThickness="1"
                                BackgroundColor="{StaticResource Surface}"
                                StrokeShape="RoundRectangle 8" Padding="14,10">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsNext}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsDoneToday}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Leaf}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Header}" FontFamily="PixelUI" FontSize="22"
                                           TextColor="{StaticResource OnBg}" />
                                    <Label Grid.Column="1" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}"
                                           FontFamily="PixelUI" FontSize="16" TextColor="{StaticResource Accent}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding Summary}" FontSize="14" TextColor="{StaticResource Muted}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Tools -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,20">
                <Button Text="Exercise library" Command="{Binding OpenLibraryCommand}" />
                <Button Grid.Column="1" Text="My gear" Command="{Binding OpenGearCommand}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
