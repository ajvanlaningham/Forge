<?xml version="1.0" encoding="utf-8" ?>
<!-- The Today tab (Decision 20): one big action, the week at a glance, active rest, conditioning. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Forge.ViewModels"
             xmlns:cards="clr-namespace:Forge.Controls.Cards;assembly=Forge"
             x:Class="Forge.Views.TodayPage"
             x:DataType="vm:TodayViewModel"
             x:Name="Page"
             Title="Today">
    <ScrollView>
        <VerticalStackLayout Padding="18,12,18,28" Spacing="14">

            <!-- Level strip: tap for the Hero tab -->
            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Muted}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 10" Padding="10,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenHeroCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Source="{Binding SpriteFile}" HeightRequest="64" WidthRequest="48" Aspect="AspectFit" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding LevelText}" FontFamily="Display" FontSize="24" TextColor="{StaticResource Accent}" />
                            <Label Grid.Column="1" Text="{Binding XpText}" FontFamily="Body" FontSize="18"
                                   TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                        </Grid>
                        <ProgressBar Progress="{Binding XpProgress}" ProgressColor="{StaticResource Aether}" HeightRequest="8" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Where you are -->
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding DateText}" FontFamily="Body" FontSize="20" TextColor="{StaticResource Muted}" />
                <Label Text="{Binding QuestLine}" FontFamily="Display" FontSize="24" TextColor="{StaticResource OnBg}" LineBreakMode="WordWrap" />
                <HorizontalStackLayout Spacing="10">
                    <Label FontFamily="Display" Text="{Binding Pips}" FontSize="22" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                    <Label Text="{Binding PipsText}" FontFamily="Body" FontSize="18" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- The one action -->
            <Button Text="{Binding ActionText}" Command="{Binding ActionCommand}" IsVisible="{Binding HasAction}"
                    HeightRequest="72" FontFamily="Display" FontSize="26" LineBreakMode="WordWrap"
                    BackgroundColor="{StaticResource Accent}" TextColor="{StaticResource Bg}" />
            <Label Text="{Binding StatusText}" IsVisible="{Binding HasStatus}"
                   FontFamily="Display" FontSize="24" TextColor="{StaticResource Leaf}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding PlanText}" IsVisible="{Binding HasPlan}" FontSize="15" TextColor="{StaticResource Muted}" />

            <!-- A stat test on its slotted day -->
            <Border IsVisible="{Binding HasTest}" BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeShape="RoundRectangle 10" Padding="14">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding TestTitle}" FontFamily="Display" FontSize="24" TextColor="{StaticResource Accent}" />
                    <Label Text="{Binding TestText}" FontSize="15" TextColor="{StaticResource OnBg}" />
                    <Button Text="Take the test" Command="{Binding TestCommand}" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Active rest -->
            <Border IsVisible="{Binding ShowActiveRest}" BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Leaf}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="14">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding ActiveRestTitle}" FontFamily="Display" FontSize="24" TextColor="{StaticResource Leaf}" />
                    <Label Text="Not training today? Move a little. It keeps your streak and your perfect week."
                           FontSize="15" TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding ActiveRestText}" FontSize="15" TextColor="{StaticResource OnBg}" />
                    <Button Text="{Binding ActiveRestButton}" Command="{Binding ToggleActiveRestCommand}" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Weekly conditioning -->
            <cards:WeeklyConditioningCard x:Name="ConditioningCard" />

            <Label Text="{Binding StreakText}" FontFamily="Body" FontSize="20"
                   TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />

            <Button Text="Start an open session" Command="{Binding StartOpenCommand}" IsVisible="{Binding CanStartOpen}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
