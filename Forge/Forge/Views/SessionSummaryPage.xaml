<?xml version="1.0" encoding="utf-8" ?>
<!-- After a session: the one celebration (Decision 26). Three tiles, the week strip, a level-up banner
     when one happened, and DONE back to the map. Every set and "next time" sit behind one toggle. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Forge.ViewModels"
             x:Class="Forge.Views.SessionSummaryPage"
             Shell.TabBarIsVisible="False"
             x:DataType="vm:SessionSummaryViewModel"
             x:Name="Page"
             Title="Session complete">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20,16" Spacing="16">
                <Label Text="VANQUISHED!" FontFamily="Display" FontSize="40" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Heading}" FontFamily="Display" FontSize="26" TextColor="{StaticResource OnBg}" HorizontalTextAlignment="Center" />

                <!-- Level up, as a banner rather than another screen -->
                <Border IsVisible="{Binding HasLevelBanner}" BackgroundColor="{StaticResource Aether}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14" Padding="14,10">
                    <Label Text="{Binding LevelBanner}" FontFamily="Display" FontSize="28" TextColor="{StaticResource Bg}" HorizontalTextAlignment="Center" />
                </Border>

                <!-- Three tiles -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Leaf}" StrokeThickness="2" StrokeShape="RoundRectangle 14" Padding="6,10">
                        <VerticalStackLayout>
                            <Label Text="{Binding MinutesTile}" FontFamily="GymNum" FontSize="44" TextColor="{StaticResource Leaf}" HorizontalTextAlignment="Center" />
                            <Label Text="MINUTES" FontFamily="Display" FontSize="17" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Danger}" StrokeThickness="2" StrokeShape="RoundRectangle 14" Padding="6,10">
                        <VerticalStackLayout>
                            <Label Text="{Binding SetsTile}" FontFamily="GymNum" FontSize="44" TextColor="{StaticResource Danger}" HorizontalTextAlignment="Center" />
                            <Label Text="SETS" FontFamily="Display" FontSize="17" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeShape="RoundRectangle 14" Padding="6,10">
                        <VerticalStackLayout>
                            <Label Text="{Binding XpTile}" FontFamily="GymNum" FontSize="44" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding XpCaption}" FontFamily="Display" FontSize="17" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- The week -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding WeekStrip}" FontFamily="Body" FontSize="40" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding WeekText}" FontFamily="Body" FontSize="17" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- How did that feel? One optional tap (Decision 28) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="HOW DID THAT FEEL?" FontFamily="Display" FontSize="24" TextColor="{StaticResource OnBg}" HorizontalTextAlignment="Center" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Text="EASY" Command="{Binding FeelCommand}" CommandParameter="Easy" FontFamily="Display" FontSize="24" HeightRequest="60">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsEasy}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Leaf}" />
                                    <Setter Property="TextColor" Value="{StaticResource Bg}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="RIGHT" Command="{Binding FeelCommand}" CommandParameter="Right" FontFamily="Display" FontSize="24" HeightRequest="60">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsRight}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                    <Setter Property="TextColor" Value="{StaticResource Bg}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="2" Text="HARD" Command="{Binding FeelCommand}" CommandParameter="Hard" FontFamily="Display" FontSize="24" HeightRequest="60">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsHard}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                                    <Setter Property="TextColor" Value="{StaticResource Bg}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    <Label Text="{Binding FeelNote}" FontFamily="Body" FontSize="16" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Button Text="{Binding DetailsText}" Command="{Binding ToggleDetailsCommand}" Style="{StaticResource SecondaryButton}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="8" IsVisible="{Binding ShowDetails}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SummaryLine">
                            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Muted}"
                                    StrokeShape="RoundRectangle 10" Padding="12,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenExerciseCommand}"
                                        CommandParameter="{Binding Name}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" FontFamily="Display" FontSize="22" TextColor="{StaticResource OnBg}" />
                                    <Label Text="{Binding Detail}" FontFamily="GymNum" FontSize="22" TextColor="{StaticResource Muted}" />
                                    <Label Text="{Binding Records}" IsVisible="{Binding HasRecords}" FontFamily="Body" FontSize="17"
                                           TextColor="{StaticResource OnBg}" />
                                    <Label Text="{Binding Next}" IsVisible="{Binding HasNext}" FontFamily="Body" FontSize="17"
                                           TextColor="{StaticResource Accent}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1" Text="DONE" Clicked="OnDone" Style="{StaticResource PrimaryButton}" HeightRequest="76" FontSize="34" Margin="16,8,16,16" />
    </Grid>
</ContentPage>
