<?xml version="1.0" encoding="utf-8" ?>
<!-- The Hero tab (Decision 20): the character, the Armoury, the Pack. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Forge.ViewModels"
             xmlns:models="clr-namespace:Forge.Models"
             xmlns:cards="clr-namespace:Forge.Controls.Cards;assembly=Forge"
             x:Class="Forge.Views.HeroPage"
             x:DataType="vm:HeroViewModel"
             Title="Hero">
    <ScrollView>
        <VerticalStackLayout Padding="18,12,18,28" Spacing="16">

            <!-- The hero: tap to choose race and class -->
            <VerticalStackLayout Spacing="2">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeLookCommand}" />
                </VerticalStackLayout.GestureRecognizers>
                <Image Source="{Binding SpriteFile}" HeightRequest="200" Aspect="AspectFit" HorizontalOptions="Center"
                       SemanticProperties.Description="Your character" />
                <Label Text="{Binding HeroTitle}" FontFamily="Display" FontSize="26" TextColor="{StaticResource OnBg}"
                       HorizontalTextAlignment="Center" />
                <Label Text="tap to change" FontSize="15" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Label Text="{Binding StreakText}" FontFamily="Body" FontSize="20" TextColor="{StaticResource Accent}"
                   HorizontalTextAlignment="Center" />

            <cards:StatCard x:Name="Stats" />
            <!-- Stat tests: latest score, change, trend, the raw results -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TestHistory}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatHistoryItem">
                        <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Muted}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" Padding="12,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CompareCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Label}" FontFamily="Body" FontSize="21" TextColor="{StaticResource Accent}" />
                                    <Label Text="{Binding DetailText}" FontSize="15" TextColor="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End">
                                    <Label Text="{Binding ScoreText}" FontFamily="GymNum" FontSize="34" TextColor="{StaticResource OnBg}" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding ChangeText}" FontFamily="Body" FontSize="17" TextColor="{StaticResource Leaf}" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                                <GraphicsView Grid.Row="1" Grid.ColumnSpan="2" Drawable="{Binding Trend}" IsVisible="{Binding HasTrend}" HeightRequest="36" Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="Take a stat test" Command="{Binding TakeTestCommand}" />

            <!-- Armoury: forged items -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Armoury" FontFamily="Display" FontSize="28" TextColor="{StaticResource Accent}" />
                <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Muted}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <!-- This tier's three items: lit when forged, faint until then -->
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="12" BindableLayout.ItemsSource="{Binding Rack}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:RackItem">
                                    <VerticalStackLayout Grid.Column="{Binding Column}" Grid.Row="{Binding Row}" Spacing="2">
                                        <Image Source="{Binding Sprite}" HeightRequest="60" Opacity="{Binding Opacity}" Aspect="AspectFit" />
                                        <Label Text="{Binding Name}" FontFamily="Body" FontSize="17" HorizontalTextAlignment="Center"
                                               TextColor="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                        <Label Text="{Binding ArmouryText}" FontFamily="Body" FontSize="19" TextColor="{StaticResource OnBg}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Pack: real equipment -->
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Pack" FontFamily="Display" FontSize="28" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Edit gear" Command="{Binding EditPackCommand}" />
                </Grid>
                <Label Text="The gear you own at home. Quests and swaps use it." FontSize="15" TextColor="{StaticResource Muted}" />
                <Label Text="Nothing yet. Tap Edit gear to add what you have." IsVisible="{Binding PackEmpty}"
                       FontFamily="Body" FontSize="19" TextColor="{StaticResource Muted}" />
                <FlexLayout BindableLayout.ItemsSource="{Binding Pack}" Wrap="Wrap" JustifyContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:GearItem">
                            <Border WidthRequest="116" HeightRequest="104" Margin="0,0,6,6" Padding="6,8" BackgroundColor="{StaticResource Surface}"
                                    Stroke="{StaticResource Accent}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="2">
                                    <Image Source="{Binding SpriteSource}" HeightRequest="36" WidthRequest="36" Aspect="AspectFit" />
                                    <Label Text="{Binding DisplayName}" FontSize="15" HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation" TextColor="{StaticResource OnBg}" />
                                    <Label Text="{Binding Summary}" IsVisible="{Binding HasSummary}" FontFamily="GymNum" FontSize="15"
                                           TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <!-- Condition: injuries and limitations (backlog) -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Condition" FontFamily="Display" FontSize="28" TextColor="{StaticResource Accent}" />
                <Label Text="Injuries and limitations will live here as status effects. Not built yet."
                       FontSize="15" TextColor="{StaticResource Muted}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
