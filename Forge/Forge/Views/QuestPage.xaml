<?xml version="1.0" encoding="utf-8" ?>
<!--
    The Quest tab (Decision 20): the quest underway on top, the quest board below. Programs are
    pinned to a wooden wall as parchment notices.
    Pixel art (board_wood, nail, wax_seal) comes from art/ via the render script in install mode.
    Single-world styling on purpose: ink on parchment, iron nails, a wax seal with the forge's anvil.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Forge.ViewModels"
             x:Class="Forge.Views.QuestPage"
             x:DataType="vm:QuestBoardViewModel"
             x:Name="Page"
             Title="Quest">
    <ContentPage.Resources>
        <Color x:Key="Parchment">#D9C9A3</Color>
        <Color x:Key="ParchmentShade">#B8A37A</Color>
        <Color x:Key="Ink">#2B1D14</Color>
        <Color x:Key="InkSoft">#5A4330</Color>
        <Color x:Key="WoodDark">#4A3222</Color>
        <Color x:Key="WoodDeep">#2B1D14</Color>
        <Color x:Key="Wax">#8E2A2A</Color>
    </ContentPage.Resources>

    <Grid>
        <!-- The wall -->
        <Image Source="board_wood.png" Aspect="AspectFill" />

        <ScrollView>
            <VerticalStackLayout Padding="18,20,18,32" Spacing="22">

                <!-- The quest underway -->
                <Grid x:Name="CurrentQuest" x:DataType="vm:CurrentQuestViewModel" Margin="6,0">
                    <Border BackgroundColor="{StaticResource Parchment}" Stroke="{StaticResource WoodDeep}"
                            StrokeThickness="3" StrokeShape="RoundRectangle 2" Padding="18,22,18,16">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="4,6" Radius="0" Opacity="0.45" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="YOUR QUEST" FontFamily="Body" FontSize="18" TextColor="{StaticResource Wax}" />
                            <Label Text="{Binding ProgramName}" FontFamily="FantasyH" FontSize="26"
                                   TextColor="{StaticResource Ink}" Margin="0,0,56,0" LineBreakMode="WordWrap" />
                            <Label Text="{Binding WeekText}" FontFamily="Display" FontSize="22" TextColor="{StaticResource Ink}" />
                            <Label Text="{Binding BlockText}" FontFamily="Body" FontSize="17" TextColor="{StaticResource InkSoft}" />
                            <Label Text="{Binding WeekNote}" IsVisible="{Binding HasWeekNote}"
                                   FontFamily="Body" FontSize="18" TextColor="{StaticResource Wax}" />
                            <Label Text="{Binding ProgramDescription}" FontFamily="Body" FontSize="17"
                                   TextColor="{StaticResource InkSoft}" IsVisible="{Binding HasProgram, Converter={StaticResource InvertBool}}" />

                            <!-- Forge meter -->
                            <ProgressBar Progress="{Binding ForgeProgress}" ProgressColor="{StaticResource Wax}"
                                         BackgroundColor="{StaticResource ParchmentShade}" HeightRequest="10" Margin="0,6,0,0"
                                         IsVisible="{Binding HasProgram}" />
                            <Label Text="{Binding ForgeText}" FontFamily="Body" FontSize="17" TextColor="{StaticResource InkSoft}"
                                   IsVisible="{Binding HasProgram}" />

                            <BoxView HeightRequest="2" Color="{StaticResource ParchmentShade}" Margin="0,4" />

                            <!-- This week's days -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Days}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProgramDayItem">
                                        <Border BackgroundColor="#CDBB92" Stroke="{StaticResource ParchmentShade}" StrokeThickness="2"
                                                StrokeShape="RoundRectangle 2" Padding="12,8">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsNext}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource Wax}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <VerticalStackLayout Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding Header}" FontFamily="Body" FontSize="21" TextColor="{StaticResource Ink}" />
                                                    <Label Grid.Column="1" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}"
                                                           FontFamily="Body" FontSize="17" TextColor="{StaticResource Wax}" VerticalOptions="Center" />
                                                </Grid>
                                                <Label Text="{Binding Summary}" FontSize="15" TextColor="{StaticResource InkSoft}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                                <Button Text="Repeat this block" Command="{Binding RepeatBlockCommand}" IsVisible="{Binding IsBlockComplete}"
                                        FontFamily="Display" FontSize="18" BackgroundColor="{StaticResource WoodDark}" TextColor="#E6E1CF"
                                        BorderColor="Black" BorderWidth="2" CornerRadius="4" />
                                <Button Text="Exercise library" Command="{Binding OpenLibraryCommand}"
                                        FontFamily="Display" FontSize="18" BackgroundColor="{StaticResource WoodDark}" TextColor="#E6E1CF"
                                        BorderColor="Black" BorderWidth="2" CornerRadius="4" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Image Source="nail.png" WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Start" VerticalOptions="Start" Margin="8,6,0,0" />
                    <Image Source="nail.png" WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="End" VerticalOptions="Start" Margin="0,6,8,0" />
                    <Image Source="wax_seal.png" WidthRequest="52" HeightRequest="52" IsVisible="{Binding HasProgram}"
                           HorizontalOptions="End" VerticalOptions="Start" Margin="0,40,22,0" />
                </Grid>

                <!-- Hanging sign -->
                <Border BackgroundColor="{StaticResource WoodDeep}" Stroke="Black" StrokeThickness="3"
                        StrokeShape="RoundRectangle 4" Padding="16,10" HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Quest Board" FontFamily="FantasyH" FontSize="34" TextColor="#E6E1CF"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Accept a quest. Four weeks at the forge, and the item is yours. Switching ends the current block."
                               FontFamily="Body" FontSize="17" TextColor="#B8A37A" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Notices -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Notices}" Spacing="26">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuestNotice">
                            <Grid Rotation="{Binding Tilt}" Margin="6,0">
                                <Border BackgroundColor="{StaticResource Parchment}" Stroke="{StaticResource WoodDeep}"
                                        StrokeThickness="3" StrokeShape="RoundRectangle 2" Padding="18,20,18,16">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="4,6" Radius="0" Opacity="0.45" />
                                    </Border.Shadow>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsRumour}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource ParchmentShade}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding ActiveText}" IsVisible="{Binding HasActiveText}"
                                               FontFamily="Body" FontSize="18" TextColor="{StaticResource Wax}"
                                               Margin="0,0,64,0" LineBreakMode="WordWrap" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,56,0">
                                            <Image Source="{Binding ItemSprite}" IsVisible="{Binding HasItem}" WidthRequest="48" HeightRequest="48" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Title}" FontFamily="FantasyH" FontSize="24"
                                                   TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding Discipline}" FontFamily="Body" FontSize="20" TextColor="{StaticResource Wax}" />
                                        <Label Text="{Binding Meta}" FontFamily="Body" FontSize="19" TextColor="{StaticResource InkSoft}" />
                                        <BoxView HeightRequest="2" Color="{StaticResource ParchmentShade}" Margin="0,2" />
                                        <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                                               FontFamily="Body" FontSize="18" TextColor="{StaticResource Ink}" />
                                        <Label Text="{Binding Versions}" IsVisible="{Binding HasVersions}"
                                               FontFamily="Body" FontSize="17" TextColor="{StaticResource InkSoft}" />
                                        <Label Text="{Binding Needs}" IsVisible="{Binding HasNeeds}"
                                               FontFamily="Body" FontSize="17" TextColor="{StaticResource Wax}" />
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                            <Label Text="{Binding Tier}" FontFamily="Body" FontSize="17" LineBreakMode="WordWrap"
                                                   TextColor="{StaticResource InkSoft}" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="{Binding ButtonText}" IsVisible="{Binding IsRumour, Converter={StaticResource InvertBool}}"
                                                    IsEnabled="{Binding CanAccept}"
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.AcceptCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    FontFamily="Display" FontSize="20" HeightRequest="48" Padding="16,0"
                                                    BackgroundColor="{StaticResource WoodDark}" TextColor="#E6E1CF"
                                                    BorderColor="Black" BorderWidth="2" CornerRadius="4" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                                <!-- Pinned with nails; sealed with the forge's anvil -->
                                <Image Source="nail.png" WidthRequest="20" HeightRequest="20"
                                       HorizontalOptions="Start" VerticalOptions="Start" Margin="8,6,0,0" />
                                <Image Source="nail.png" WidthRequest="20" HeightRequest="20"
                                       HorizontalOptions="End" VerticalOptions="Start" Margin="0,6,8,0" />
                                <Image Source="wax_seal.png" WidthRequest="52" HeightRequest="52"
                                       HorizontalOptions="End" VerticalOptions="Start" Margin="0,40,22,0"
                                       IsVisible="{Binding IsActive}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
