<?xml version="1.0" encoding="utf-8" ?>
<!-- The guided session: one set at a time, big enough to read from the floor (legibility pass,
     2026-11-13). The day is a foe with a health bar that drops set by set; the countdown sits in a
     ring that drains. Each phase has one huge action at the bottom; adjustments are small links. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Forge.ViewModels"
             x:Class="Forge.Views.GuidedSessionPage"
             Shell.TabBarIsVisible="False"
             x:DataType="vm:GuidedSessionViewModel"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="List" Command="{Binding OverviewCommand}" />
        <ToolbarItem Text="⋮" Command="{Binding MenuCommand}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="TextColor" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="Display" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="Huge" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="HeightRequest" Value="80" />
            <Setter Property="FontSize" Value="34" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="18,8,18,18" RowSpacing="8">
        <!-- The day's foe: health drops with every set -->
        <VerticalStackLayout Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding FoeText}" FontFamily="Display" FontSize="22" TextColor="{StaticResource OnBg}" LineBreakMode="TailTruncation" />
                <Label Grid.Column="1" Text="{Binding ElapsedText}" FontFamily="GymNum" FontSize="24" TextColor="{StaticResource Muted}" />
            </Grid>
            <GraphicsView Drawable="{Binding Health}" HeightRequest="20" />
        </VerticalStackLayout>

        <!-- READY: waiting for a tap (after coming back to a session) -->
        <Grid Grid.Row="1" IsVisible="{Binding IsReady}" RowDefinitions="*,Auto">
            <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                <Label Text="{Binding Caption}" FontFamily="Display" FontSize="26" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding ExerciseName}" FontFamily="Display" FontSize="36" TextColor="{StaticResource OnBg}"
                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                <Label HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding LoadText}" FontFamily="GymNum" FontSize="56" TextColor="{StaticResource Accent}" />
                            <Span Text="  " />
                            <Span Text="{Binding WorkText}" FontFamily="GymNum" FontSize="56" TextColor="{StaticResource OnBg}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="{Binding NotesText}" IsVisible="{Binding HasNotes}" FontFamily="Body" FontSize="18" TextColor="{StaticResource Muted}"
                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="3" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1" Spacing="6">
                <Button Text="START SET" Command="{Binding StartCommand}" Style="{StaticResource Huge}" />
                <Label Text="{Binding ReadyText}" FontFamily="Body" FontSize="16" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- WORK: the set, running inside the ring -->
        <Grid Grid.Row="1" IsVisible="{Binding IsWork}" RowDefinitions="*,Auto">
            <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="{Binding Caption}" FontFamily="Display" FontSize="28" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding ExerciseName}" FontFamily="Display" FontSize="34" TextColor="{StaticResource OnBg}"
                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                <Grid HeightRequest="260" WidthRequest="260" HorizontalOptions="Center">
                    <GraphicsView Drawable="{Binding Ring}" />
                    <!-- Changing sides: the whole ring says so -->
                    <Label IsVisible="{Binding IsSwitching}" Text="SWITCH&#10;SIDES" FontFamily="Display" FontSize="46" TextColor="{StaticResource Leaf}"
                           HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    <VerticalStackLayout VerticalOptions="Center" Spacing="0" IsVisible="{Binding IsNotSwitching}">
                        <Label Text="{Binding LoadText}" FontFamily="GymNum" FontSize="44" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding WorkText}" FontFamily="GymNum" FontSize="44" TextColor="{StaticResource OnBg}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding ClockText}" FontFamily="GymNum" FontSize="30" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
                <Label Text="{Binding NotesText}" IsVisible="{Binding HasNotes}" FontFamily="Body" FontSize="18" TextColor="{StaticResource Muted}"
                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2" />
                <Label Text="{Binding ThenText}" FontFamily="Body" FontSize="16" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1" Spacing="2">
                <Button Text="DONE" Command="{Binding SkipCommand}" Style="{StaticResource Huge}" />
                <Grid ColumnDefinitions="*,*">
                    <Button Text="{Binding PauseText}" Command="{Binding PauseCommand}" Style="{StaticResource Link}" />
                    <Button Grid.Column="1" Text="+10 s" Command="{Binding MoreTimeCommand}" Style="{StaticResource Link}" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- REST: the ring drains, then the next set starts on its own -->
        <Grid Grid.Row="1" IsVisible="{Binding IsRest}" RowDefinitions="*,Auto,Auto" RowSpacing="10">
            <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                <Grid HeightRequest="230" WidthRequest="230" HorizontalOptions="Center">
                    <GraphicsView Drawable="{Binding Ring}" />
                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                        <Label Text="{Binding Caption}" FontFamily="Display" FontSize="26" TextColor="{StaticResource Leaf}" HorizontalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsGetReady}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding ClockText}" FontFamily="GymNum" FontSize="72" TextColor="{StaticResource OnBg}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
                <Label Text="UP NEXT" FontFamily="Display" FontSize="20" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="0,6,0,0" />
                <Label Text="{Binding ExerciseName}" FontFamily="Display" FontSize="30" TextColor="{StaticResource OnBg}"
                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                <Label HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding LoadText}" FontFamily="GymNum" FontSize="36" TextColor="{StaticResource Accent}" />
                            <Span Text="  " />
                            <Span Text="{Binding WorkText}" FontFamily="GymNum" FontSize="36" TextColor="{StaticResource OnBg}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="{Binding NotesText}" IsVisible="{Binding HasNotes}" FontFamily="Body" FontSize="17" TextColor="{StaticResource Muted}"
                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2" />
            </VerticalStackLayout>

            <!-- After a hard set: did you get them all? -->
            <Border Grid.Row="1" IsVisible="{Binding IsAsking}" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Accent}"
                    StrokeThickness="2" StrokeShape="RoundRectangle 12" Padding="10,8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding AskText}" FontFamily="Display" FontSize="28" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />
                    <Grid ColumnDefinitions="2*,*,*,*" ColumnSpacing="6">
                        <Button Text="YES" Command="{Binding AnswerYesCommand}" HeightRequest="56" FontSize="24"
                                BackgroundColor="{StaticResource Accent}" TextColor="{StaticResource Bg}" BorderWidth="0" />
                        <Button Grid.Column="1" Text="−1" Command="{Binding AnswerShortCommand}" CommandParameter="1" HeightRequest="56" FontSize="22" Padding="0" />
                        <Button Grid.Column="2" Text="−2" Command="{Binding AnswerShortCommand}" CommandParameter="2" HeightRequest="56" FontSize="22" Padding="0" />
                        <Button Grid.Column="3" Text="−3" Command="{Binding AnswerShortCommand}" CommandParameter="3" HeightRequest="56" FontSize="22" Padding="0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Fix the set just logged -->
            <Border Grid.Row="1" IsVisible="{Binding ShowLogged}" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Muted}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="10,8">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding LoggedText}" FontFamily="Body" FontSize="17" TextColor="{StaticResource OnBg}" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                        <Button Text="− rep" Command="{Binding LoggedRepsDownCommand}" HeightRequest="48" Padding="0" FontSize="18" />
                        <Button Grid.Column="1" Text="+ rep" Command="{Binding LoggedRepsUpCommand}" HeightRequest="48" Padding="0" FontSize="18" />
                        <Button Grid.Column="2" Text="− wt" Command="{Binding LoggedLoadDownCommand}" HeightRequest="48" Padding="0" FontSize="18" />
                        <Button Grid.Column="3" Text="+ wt" Command="{Binding LoggedLoadUpCommand}" HeightRequest="48" Padding="0" FontSize="18" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="2" Spacing="2">
                <Button Text="{Binding RestButtonText}" Command="{Binding SkipCommand}" Style="{StaticResource Huge}" />
                <Grid ColumnDefinitions="*,*,*">
                    <Button Text="{Binding PauseText}" Command="{Binding PauseCommand}" Style="{StaticResource Link}" />
                    <Button Grid.Column="1" Text="−15 s" Command="{Binding LessTimeCommand}" Style="{StaticResource Link}" />
                    <Button Grid.Column="2" Text="+15 s" Command="{Binding MoreTimeCommand}" Style="{StaticResource Link}" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- DONE: only on a test day; otherwise the session goes straight to the summary -->
        <Grid Grid.Row="1" IsVisible="{Binding IsDone}" RowDefinitions="*,Auto">
            <VerticalStackLayout Spacing="16" VerticalOptions="Center">
                <Label Text="ONE TRIAL LEFT" FontFamily="Display" FontSize="40" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding DoneText}" FontFamily="Body" FontSize="20" TextColor="{StaticResource OnBg}" HorizontalTextAlignment="Center" />
                <!-- On a test day the test is the session's last steps -->
                <Border IsVisible="{Binding HasTest}" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Accent}"
                        StrokeThickness="2" StrokeShape="RoundRectangle 12" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding TestText}" FontFamily="Body" FontSize="18" TextColor="{StaticResource OnBg}" />
                        <Button Text="{Binding TestButton}" Command="{Binding TestCommand}" Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <Button Grid.Row="1" Text="FINISH" Command="{Binding FinishCommand}" Style="{StaticResource Huge}" />
        </Grid>
    </Grid>
</ContentPage>
