<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:Forge.Resources.Strings"
             xmlns:vm="clr-namespace:Forge.ViewModels"
             xmlns:controls="clr-namespace:Forge.Controls.Cards;assembly=Forge"
             x:DataType="vm:CheckInViewModel"
             x:Class="Forge.Views.CheckInPage"
             Title="{x:Static res:AppResources.CheckInPage_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <!-- Trend context sits above the form so the average moves in real time as
                 the user saves. -->
            <controls:WeightTrendCard BindingContext="{Binding WeightTrendCard}" />

            <Label FontFamily="Display" Text="{x:Static res:AppResources.CheckInPage_WeightHeader}"
                   FontSize="22"
                   FontAttributes="Bold" />

            <Label Text="{x:Static res:AppResources.CheckInPage_DateLabel}" />
            <DatePicker Date="{Binding EntryDate}"
                        MaximumDate="{Binding MaximumEntryDate}" />

            <Label Text="{Binding WeightHint}" />
            <Entry Text="{Binding WeightText}"
                   Keyboard="Numeric"
                   Placeholder="0.0" />

            <Label Text="{x:Static res:AppResources.CheckInPage_NoteLabel}" />
            <Entry Text="{Binding Note}" />

            <Button Text="{x:Static res:AppResources.CheckInPage_SaveBtn}"
                    Command="{Binding SaveCommand}"
                    HorizontalOptions="Fill" />

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatus}" />

            <BoxView HeightRequest="1" Opacity="0.2" Margin="0,8" />

            <!-- Recovery (PBI 3.4): typed, or filled from Health Connect. Same date as above. -->
            <Label FontFamily="Display" Text="Recovery" FontSize="22" FontAttributes="Bold" />
            <Label Text="{Binding RecoveryDateText}" FontSize="15" Opacity="0.7" />

            <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                <Label Text="Resting heart rate (bpm)" VerticalOptions="Center" />
                <Entry Grid.Column="1" Text="{Binding RestingHrText}" Keyboard="Numeric" Placeholder="—" HorizontalTextAlignment="End" />
                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RestingHrSourceText}" FontSize="15" Opacity="0.6" HorizontalTextAlignment="End" />

                <Label Grid.Row="2" Text="Sleep (h:mm)" VerticalOptions="Center" />
                <Entry Grid.Row="2" Grid.Column="1" Text="{Binding SleepText}" Keyboard="Text" Placeholder="7:30" HorizontalTextAlignment="End" />
                <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding SleepSourceText}" FontSize="15" Opacity="0.6" HorizontalTextAlignment="End" />

                <Label Grid.Row="4" Text="Steps" VerticalOptions="Center" />
                <Entry Grid.Row="4" Grid.Column="1" Text="{Binding StepsText}" Keyboard="Numeric" Placeholder="—" HorizontalTextAlignment="End" />
                <Label Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding StepsSourceText}" FontSize="15" Opacity="0.6" HorizontalTextAlignment="End" />
            </Grid>

            <Button Text="Save recovery" Command="{Binding SaveRecoveryCommand}" HorizontalOptions="Fill" />
            <Label Text="{Binding RecoveryStatus}" IsVisible="{Binding HasRecoveryStatus}" />

            <Label Text="{Binding HealthText}" FontSize="15" Opacity="0.7" Margin="0,8,0,0" />

            <BoxView HeightRequest="1" Opacity="0.2" Margin="0,8" />

            <Label Text="{Binding PlaceholderText}"
                   FontSize="15"
                   Opacity="0.7" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
