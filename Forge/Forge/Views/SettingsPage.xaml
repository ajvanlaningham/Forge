<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:Forge.Resources.Strings"
             xmlns:vm="clr-namespace:Forge.ViewModels"
             x:DataType="vm:SettingsViewModel"
             x:Class="Forge.Views.SettingsPage"
             Title="{x:Static res:AppResources.SettingsPage_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label FontFamily="Display" Text="{x:Static res:AppResources.SettingsPage_UpdatesHeader}"
                   FontSize="22"
                   FontAttributes="Bold" />

            <Label Text="{Binding InstalledVersion}" />

            <!-- No IsEnabled binding: AsyncRelayCommand reports CanExecute=false while it runs. -->
            <Button Text="{x:Static res:AppResources.SettingsPage_CheckForUpdates}"
                    Command="{Binding CheckForUpdatesCommand}"
                    HorizontalOptions="Fill" />

            <ActivityIndicator IsRunning="{Binding IsChecking}"
                               IsVisible="{Binding IsChecking}"
                               HorizontalOptions="Start" />

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatus}" />

            <Label Text="{Binding UpdateNotes}"
                   IsVisible="{Binding HasNotes}"
                   FontSize="15"
                   Opacity="0.8" />

            <Button Text="{x:Static res:AppResources.SettingsPage_DownloadAndInstall}"
                    Command="{Binding DownloadAndInstallCommand}"
                    IsVisible="{Binding UpdateAvailable}"
                    HorizontalOptions="Fill" />

            <ProgressBar Progress="{Binding DownloadProgress}"
                         IsVisible="{Binding IsDownloading}" />

            <Label Text="{x:Static res:AppResources.SettingsPage_InstallHint}"
                   FontSize="15"
                   Opacity="0.7" />

            <BoxView HeightRequest="1" Opacity="0.2" Margin="0,8" />

            <Label FontFamily="Display" Text="{x:Static res:AppResources.SettingsPage_UnitsHeader}"
                   FontSize="22"
                   FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="8"
                  VerticalOptions="Center">
                <Label Grid.Column="0"
                       Text="{x:Static res:AppResources.SettingsPage_WeightUnitLabel}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{x:Static res:AppResources.SettingsPage_WeightUnit_Pounds}"
                       VerticalOptions="Center" />
                <Switch Grid.Column="2"
                        IsToggled="{Binding UseKilograms}"
                        VerticalOptions="Center" />
                <Label Grid.Column="3"
                       Text="{x:Static res:AppResources.SettingsPage_WeightUnit_Kilograms}"
                       VerticalOptions="Center" />
            </Grid>

            <BoxView HeightRequest="1" Opacity="0.2" Margin="0,8" />

            <Label FontFamily="Display" Text="Training" FontSize="22" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <Label Text="Default rest between sets" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="−" Command="{Binding RestDownCommand}" WidthRequest="48" Padding="0" />
                <Label Grid.Column="2" Text="{Binding RestText}" FontFamily="OpenSansSemibold" FontSize="20"
                       VerticalOptions="Center" WidthRequest="56" HorizontalTextAlignment="Center" />
                <Button Grid.Column="3" Text="+" Command="{Binding RestUpCommand}" WidthRequest="48" Padding="0" />
            </Grid>
            <Label Text="Used when a program doesn't set its own rest. Warm-ups rest at most a minute." FontSize="15" Opacity="0.7" />
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                <Label Text="Rest days" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="Guided" VerticalOptions="Center" />
                <Switch Grid.Column="2" IsToggled="{Binding FreestyleRest}" VerticalOptions="Center" />
                <Label Grid.Column="3" Text="Freestyle" VerticalOptions="Center" />
            </Grid>
            <Label Text="Guided runs a ten-minute mobility flow on the timer. Freestyle just logs your own practice, like yoga or a walk." FontSize="15" Opacity="0.7" />
            <Button Text="Gym equipment" Command="{Binding OpenGymEquipmentCommand}" />
            <Label Text="Home uses My gear on the Hero tab." FontSize="15" Opacity="0.7" />

            <Label Text="Comparisons" FontSize="20" FontAttributes="Bold" Margin="0,16,0,0" />
            <Button Text="Compare my test results (optional)" Command="{Binding OpenComparisonsCommand}" />
            <Button Text="Preview the first run" Command="{Binding PreviewFirstRunCommand}" Margin="0,8,0,0" />
            <Label Text="The welcome screens a new install shows. Walking through them changes nothing." FontSize="15" Opacity="0.7" />

            <BoxView HeightRequest="1" Opacity="0.2" Margin="0,8" />

            <Label FontFamily="Display" Text="Connections" FontSize="22" FontAttributes="Bold" />

            <Label Text="{Binding HealthTitle}" FontSize="18" FontAttributes="Bold" />
            <Label Text="Fills the check-in's resting heart rate, sleep and steps from your watch or phone. Read-only; what you type always wins."
                   FontSize="15" Opacity="0.7" />
            <Label Text="{Binding HealthStatus}" />
            <Button Text="{Binding HealthButtonText}" Command="{Binding HealthCommand}" IsVisible="{Binding HasHealthButton}" />

            <Label Text="Strava" FontSize="18" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="Finished strength sessions post to Strava as Weight Training, with your sets in the description. Cardio stays off, so a watch's own uploads aren't doubled."
                   FontSize="15" Opacity="0.7" />
            <Label Text="{Binding StravaStatus}" />
            <Button Text="{Binding StravaButtonText}" Command="{Binding StravaCommand}" IsEnabled="{Binding StravaAvailable}" />

            <BoxView HeightRequest="1" Opacity="0.2" Margin="0,8" />

            <Label FontFamily="Display" Text="Backup" FontSize="22" FontAttributes="Bold" />
            <Label Text="A copy of your data is saved once a day when you open Forge, in Download/Forge. Copies survive uninstalling the app; restore one here." 
                   FontSize="15" Opacity="0.7" />
            <Label Text="{Binding BackupStatus}" />
            <Button Text="Back up now" Command="{Binding BackUpNowCommand}" />
            <Button Text="Restore from backup…" Command="{Binding RestoreCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBackingUp}" IsVisible="{Binding IsBackingUp}" HeightRequest="24" />

            <Label Text="Off-phone backup" FontSize="18" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="An encrypted copy goes to nidavellir once a day. It's locked with a recovery key that only you keep; the server can't read it. Restore it on any phone with the key."
                   FontSize="15" Opacity="0.7" />
            <Label Text="{Binding OffsiteStatus}" />
            <Button Text="{Binding OffsiteButtonText}" Command="{Binding OffsiteCommand}" />
            <Button Text="Back up off-phone now" Command="{Binding OffsiteNowCommand}" IsVisible="{Binding OffsiteOn}" />
            <Button Text="Restore from nidavellir…" Command="{Binding RestoreOffsiteCommand}" />
            <Button Text="Turn off off-phone backup" Command="{Binding OffsiteOffCommand}" IsVisible="{Binding OffsiteOn}"
                    BackgroundColor="Transparent" Opacity="0.7" />

            <BoxView HeightRequest="1" Opacity="0.2" Margin="0,8" />

            <Label FontFamily="Display" Text="{x:Static res:AppResources.SettingsPage_AboutHeader}"
                   FontSize="22"
                   FontAttributes="Bold" />

            <Label Text="{x:Static res:AppResources.SettingsPage_Placeholder}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
