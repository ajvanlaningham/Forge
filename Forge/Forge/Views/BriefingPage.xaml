<?xml version="1.0" encoding="utf-8" ?>
<!-- The briefing before a guided session (an intro screen since the legibility pass, 2026-11-13):
     the hero, the day, two tiles, where, what to gather, BEGIN. Per-exercise weights and swaps sit
     behind one toggle. Nothing is timed or logged until BEGIN. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Forge.ViewModels"
             x:Class="Forge.Views.BriefingPage"
             x:DataType="vm:BriefingViewModel"
             Shell.TabBarIsVisible="False"
             Title="">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16,12,16,20" Spacing="14">
                <Image Source="{Binding HeroSprite}" HeightRequest="110" WidthRequest="110" HorizontalOptions="Center" />
                <Label Text="{Binding Title}" FontFamily="Display" FontSize="32" TextColor="{StaticResource OnBg}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Subtitle}" FontFamily="Body" FontSize="17" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />

                <!-- Two tiles -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeShape="RoundRectangle 14" Padding="8,10">
                        <VerticalStackLayout>
                            <Label Text="{Binding ExercisesTile}" FontFamily="GymNum" FontSize="44" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />
                            <Label Text="EXERCISES" FontFamily="Display" FontSize="18" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Leaf}" StrokeThickness="2" StrokeShape="RoundRectangle 14" Padding="8,10">
                        <VerticalStackLayout>
                            <Label Text="{Binding MinutesTile}" FontFamily="GymNum" FontSize="44" TextColor="{StaticResource Leaf}" HorizontalTextAlignment="Center" />
                            <Label Text="MINUTES" FontFamily="Display" FontSize="18" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Where -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Home" Command="{Binding HomeCommand}" FontFamily="Display" FontSize="22" HeightRequest="52">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding AtHome}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="TextColor" Value="{StaticResource Bg}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="Gym" Command="{Binding GymCommand}" FontFamily="Display" FontSize="22" HeightRequest="52">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding AtGym}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="TextColor" Value="{StaticResource Bg}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <!-- First time with a weighted lift: which weights? (user, 2026-11-13) -->
                <Border IsVisible="{Binding HasFirstTime}" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Aether}"
                        StrokeThickness="2" StrokeShape="RoundRectangle 12" Padding="14,12">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="FIRST TIME: PICK YOUR WEIGHTS" FontFamily="Display" FontSize="24" TextColor="{StaticResource Aether}" />
                        <Label Text="Choose weights you could lift a few more times than asked. Forge remembers them and moves you up as you get stronger."
                               FontFamily="Body" FontSize="17" TextColor="{StaticResource Muted}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding FirstTime}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BriefItem">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontFamily="Display" FontSize="22" TextColor="{StaticResource OnBg}" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding PrescriptionText}" FontFamily="GymNum" FontSize="18" TextColor="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="−" Command="{Binding LoadDownCommand}" HeightRequest="56" WidthRequest="56" Padding="0" FontSize="28" />
                                        <Label Grid.Column="2" Text="{Binding LoadText}" FontFamily="GymNum" FontSize="30" TextColor="{StaticResource Accent}"
                                               WidthRequest="84" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                        <Button Grid.Column="3" Text="+" Command="{Binding LoadUpCommand}" HeightRequest="56" WidthRequest="56" Padding="0" FontSize="28" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Gather -->
                <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Accent}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" Padding="14,10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Gather" FontFamily="Display" FontSize="24" TextColor="{StaticResource Accent}" />
                        <Label Text="{Binding GatherText}" FontFamily="Body" FontSize="20" TextColor="{StaticResource OnBg}" />
                    </VerticalStackLayout>
                </Border>

                <!-- The plan, behind one toggle -->
                <Button Text="{Binding DetailsText}" Command="{Binding ToggleDetailsCommand}" Style="{StaticResource SecondaryButton}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="10" IsVisible="{Binding ShowDetails}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:BriefItem">
                            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Muted}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding GroupLabel}" IsVisible="{Binding HasGroup}" FontFamily="Body" FontSize="20"
                                                   TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                                            <Label Text="{Binding Name}" FontFamily="Display" FontSize="22" TextColor="{StaticResource OnBg}"
                                                   LineBreakMode="WordWrap" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding SwapText}" IsVisible="{Binding HasSwap}" FontSize="15" TextColor="{StaticResource Muted}" />
                                        <Label Text="{Binding PrescriptionText}" FontFamily="GymNum" FontSize="20" TextColor="{StaticResource OnBg}" />
                                        <Label Text="{Binding WarmupText}" IsVisible="{Binding Warmup}" FontSize="15" TextColor="{StaticResource Leaf}" />
                                        <Label Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="15" TextColor="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                    <!-- Weight -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" IsVisible="{Binding ShowLoad}" VerticalOptions="Center">
                                        <Button Text="▲" Command="{Binding LoadUpCommand}" HeightRequest="40" WidthRequest="96" Padding="0" />
                                        <Label Text="{Binding LoadText}" FontFamily="GymNum" FontSize="24" TextColor="{StaticResource Accent}"
                                               HorizontalTextAlignment="Center" />
                                        <Button Text="▼" Command="{Binding LoadDownCommand}" HeightRequest="40" WidthRequest="96" Padding="0" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Begin -->
        <VerticalStackLayout Grid.Row="1" Padding="16,8,16,14" Spacing="4" BackgroundColor="{StaticResource Bg}">
            <Button Text="BEGIN" Command="{Binding BeginCommand}" Style="{StaticResource PrimaryButton}" HeightRequest="76" FontSize="34" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
