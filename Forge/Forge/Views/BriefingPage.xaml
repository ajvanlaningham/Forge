<?xml version="1.0" encoding="utf-8" ?>
<!-- The briefing before a guided session: where, what, which weights, what to gather. Nothing is
     timed or logged until BEGIN. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Forge.ViewModels"
             x:Class="Forge.Views.BriefingPage"
             x:DataType="vm:BriefingViewModel"
             Title="{Binding Title}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16,12,16,20" Spacing="14">
                <Label Text="{Binding Subtitle}" FontFamily="PixelUI" FontSize="20" TextColor="{StaticResource Muted}" />

                <!-- Where -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Home" Command="{Binding HomeCommand}" FontFamily="PixelUI" FontSize="22" HeightRequest="52">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding AtHome}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="TextColor" Value="{StaticResource Bg}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="Gym" Command="{Binding GymCommand}" FontFamily="PixelUI" FontSize="22" HeightRequest="52">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding AtGym}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="TextColor" Value="{StaticResource Bg}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <!-- Gather -->
                <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Accent}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" Padding="14,10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Gather" FontFamily="PixelUI" FontSize="24" TextColor="{StaticResource Accent}" />
                        <Label Text="{Binding GatherText}" FontFamily="PixelUI" FontSize="20" TextColor="{StaticResource OnBg}" />
                    </VerticalStackLayout>
                </Border>

                <!-- The plan -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:BriefItem">
                            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Muted}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding GroupLabel}" IsVisible="{Binding HasGroup}" FontFamily="PixelUI" FontSize="20"
                                                   TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                                            <Label Text="{Binding Name}" FontFamily="PixelUI" FontSize="22" TextColor="{StaticResource OnBg}"
                                                   LineBreakMode="WordWrap" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding SwapText}" IsVisible="{Binding HasSwap}" FontSize="12" TextColor="{StaticResource Muted}" />
                                        <Label Text="{Binding PrescriptionText}" FontFamily="GymNum" FontSize="20" TextColor="{StaticResource OnBg}" />
                                        <Label Text="{Binding WarmupText}" IsVisible="{Binding Warmup}" FontSize="13" TextColor="{StaticResource Leaf}" />
                                        <Label Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="12" TextColor="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                    <!-- Weight -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" IsVisible="{Binding ShowLoad}" VerticalOptions="Center">
                                        <Button Text="▲" Command="{Binding LoadUpCommand}" HeightRequest="40" WidthRequest="96" Padding="0" />
                                        <Label Text="{Binding LoadText}" FontFamily="GymNum" FontSize="24" TextColor="{StaticResource Accent}"
                                               HorizontalTextAlignment="Center" />
                                        <Button Text="▼" Command="{Binding LoadDownCommand}" HeightRequest="40" WidthRequest="96" Padding="0" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Begin -->
        <VerticalStackLayout Grid.Row="1" Padding="16,8,16,14" Spacing="4" BackgroundColor="{StaticResource Bg}">
            <Label Text="{Binding EstimateText}" FontFamily="PixelUI" FontSize="18" TextColor="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" />
            <Button Text="BEGIN" Command="{Binding BeginCommand}" HeightRequest="68" FontFamily="PixelUI" FontSize="30"
                    BackgroundColor="{StaticResource Accent}" TextColor="{StaticResource Bg}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
