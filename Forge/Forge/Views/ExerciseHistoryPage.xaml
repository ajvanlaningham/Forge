<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Forge.ViewModels"
             x:Class="Forge.Views.ExerciseHistoryPage"
             x:DataType="vm:ExerciseHistoryViewModel"
             Title="{Binding Name}">
    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="10">
            <Label Text="{Binding Name}" FontFamily="PixelUI" FontSize="30" TextColor="{StaticResource Accent}" />
            <Label Text="{Binding Headline}" FontFamily="PixelUI" FontSize="20" TextColor="{StaticResource OnBg}" />
            <Label Text="Not logged in a finished session yet." IsVisible="{Binding IsEmpty}"
                   FontFamily="PixelUI" FontSize="18" TextColor="{StaticResource Muted}" />

            <Border IsVisible="{Binding HasChart}" BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Muted}" StrokeShape="RoundRectangle 8" Padding="8">
                <VerticalStackLayout>
                    <Label Text="{Binding ChartCaption}" FontFamily="PixelUI" FontSize="16" TextColor="{StaticResource Muted}" />
                    <GraphicsView Drawable="{Binding Chart}" HeightRequest="220" BackgroundColor="{StaticResource Surface}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExerciseHistoryRow">
                        <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Muted}"
                                StrokeShape="RoundRectangle 8" Padding="12,8">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding DateText}" FontFamily="PixelUI" FontSize="18" TextColor="{StaticResource Accent}" />
                                    <Label Grid.Column="1" Text="{Binding BestText}" FontFamily="PixelUI" FontSize="16"
                                           TextColor="{StaticResource Muted}" />
                                </Grid>
                                <Label Text="{Binding SetsText}" FontFamily="GymNum" FontSize="24" TextColor="{StaticResource OnBg}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
