<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Forge.ViewModels"
             x:Class="Forge.Views.SessionHistoryPage"
             x:DataType="vm:SessionHistoryViewModel"
             x:Name="Page"
             Title="History">
    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="10">
            <Label Text="No finished sessions yet." IsVisible="{Binding IsEmpty}"
                   FontFamily="PixelUI" FontSize="20" TextColor="{StaticResource Muted}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sessions}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionHistoryItem">
                        <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Muted}"
                                StrokeShape="RoundRectangle 8" Padding="14,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenCommand}"
                                    CommandParameter="{Binding SessionId}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Title}" FontFamily="PixelUI" FontSize="22" TextColor="{StaticResource OnBg}" />
                                    <Label Grid.Column="1" Text="{Binding DateText}" FontFamily="PixelUI" FontSize="18"
                                           TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding Detail}" FontFamily="PixelUI" FontSize="17" TextColor="{StaticResource Muted}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
